\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-image metric comparison between AGCWD (blue) and CLAHE (orange) across six CT scan test images. AGCWD consistently achieves higher RMS Contrast and Edge Preservation Index (EPI), demonstrating stronger enhancement of low-contrast structures. CLAHE achieves higher PSNR and SSIM in most cases, indicating closer numerical fidelity to the original image.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:metrics_agcwd_clahe}{{6}{7}{Per-image metric comparison between AGCWD (blue) and CLAHE (orange) across six CT scan test images. AGCWD consistently achieves higher RMS Contrast and Edge Preservation Index (EPI), demonstrating stronger enhancement of low-contrast structures. CLAHE achieves higher PSNR and SSIM in most cases, indicating closer numerical fidelity to the original image}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Per-image metric comparison between software AGCWD (green) and hardware AGCWD (purple) across six CT scan test images. The hardware pipeline achieves lower MSE and AMBE relative to the original, while the software achieves higher Entropy and RMS Contrast. Both implementations show closely matched performance across all metrics.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:metrics_hw_sw}{{7}{7}{Per-image metric comparison between software AGCWD (green) and hardware AGCWD (purple) across six CT scan test images. The hardware pipeline achieves lower MSE and AMBE relative to the original, while the software achieves higher Entropy and RMS Contrast. Both implementations show closely matched performance across all metrics}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Sample CT scan images (4 cases, rows) showing: original CT (col.~1), software AGCWD output (col.~2), hardware AGCWD output (col.~3), signed difference map SW$-$Orig (col.~4, red-blue scale), and signed difference map HW$-$Orig (col.~5). Red pixels indicate brightening; blue pixels indicate darkening relative to the original. Both pipelines apply consistent, strong enhancement to low-intensity anatomical regions, with the hardware pipeline producing a slightly more conservative intensity shift.}}{8}{figure.8}\protected@file@percent }
\newlabel{fig:diff_maps}{{8}{8}{Sample CT scan images (4 cases, rows) showing: original CT (col.~1), software AGCWD output (col.~2), hardware AGCWD output (col.~3), signed difference map SW$-$Orig (col.~4, red-blue scale), and signed difference map HW$-$Orig (col.~5). Red pixels indicate brightening; blue pixels indicate darkening relative to the original. Both pipelines apply consistent, strong enhancement to low-intensity anatomical regions, with the hardware pipeline producing a slightly more conservative intensity shift}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IX-A}}Clinical Significance of Results}{8}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Direct pixel-level difference between software and hardware AGCWD outputs (rightmost column, blue-white-red scale) for four representative CT scan images. Values near zero (white) indicate agreement between the two implementations. Residual differences are small and spatially distributed, consistent with the high mean Pearson correlation of $r = 0.9817$ across all test images, confirming that the hardware pipeline faithfully replicates the software algorithm.}}{9}{figure.9}\protected@file@percent }
\newlabel{fig:sw_hw_diff}{{9}{9}{Direct pixel-level difference between software and hardware AGCWD outputs (rightmost column, blue-white-red scale) for four representative CT scan images. Values near zero (white) indicate agreement between the two implementations. Residual differences are small and spatially distributed, consistent with the high mean Pearson correlation of $r = 0.9817$ across all test images, confirming that the hardware pipeline faithfully replicates the software algorithm}{figure.9}{}}
